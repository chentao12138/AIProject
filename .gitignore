# 编辑器
# ============================================================

.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.vscode-test/
.history/
*.swp
*.swo
*~
*.orig
*.tmp
*.sublime-project
*.sublime-workspace
.editorconfig.local

# ============================================================
# Docker 数据（项目内如启用 Docker Compose 数据卷）
# ============================================================

mysql-data/
docker-data/
volumes/
