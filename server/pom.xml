<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.aistudy</groupId>
    <artifactId>server</artifactId>
    <version>0.1.0-SPIKE</version>
    <packaging>jar</packaging>

    <name>AIProject Server</name>
    <description>AI Study Workspace Backend - SPIKE-001 minimal skeleton</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus (Spring Boot 3 starter) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.11</version>
        </dependency>

        <!-- MySQL JDBC Driver (version managed by Spring Boot) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Spring Security (SPIKE-004 gate) -->
        <!-- MICRO-01 only verifies the dependency can be wired into the
             existing Spring Boot context without breaking /health. Real auth
             (JWT, formLogin, httpBasic, CSRF, session policy, UserDetailsService,
             PasswordEncoder) is deferred to later MICROs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Security OAuth2 JOSE / JWT (SPIKE-004 MICRO-04A gate) -->
        <!-- Provides Nimbus JOSE+JWT (JWS / JWE / JWT parsing and signing)
             that later MICROs will use to build JwtEncoder / JwtDecoder /
             secret-key loading / Bearer authentication. MICRO-04A only
             introduces the library so that later MICROs can assume the
             dependency is available; nothing in this MICRO implements JWT
             encode/decode, Bearer Token handling, or any token issuing.

             We deliberately do NOT add spring-boot-starter-oauth2-resource-server
             here because that pulls in Bearer authentication, which is a
             separate MICRO. We also do NOT add jjwt-* because the project
             should have exactly ONE JWT library, not two. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!-- Spring Boot OAuth2 Resource Server (SPIKE-004 MICRO-05A gate) -->
        <!-- Pulls in the Bearer token plumbing (BearerTokenAuthenticationFilter,
             JwtDecoder / JwtAuthenticationConverter /
             JwtGrantedAuthoritiesConverter defaults) that later MICROs will
             wire into SecurityFilterChain. MICRO-05A only introduces the
             dependency so that later MICROs can assume Bearer authentication
             classes are available; nothing in this MICRO configures
             oauth2ResourceServer(), parses Authorization headers, or
             introduces any AuthenticationProvider / UserDetailsService.

             Version is managed by the Spring Boot 3.5.0 BOM. We deliberately
             do NOT remove or re-order the existing spring-security-oauth2-jose
             dependency here even though the resource-server starter may
             transitively pull in overlapping OAuth2/JWT components; any
             cleanup is deferred until after the Bearer SPIKE is complete. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Flyway (version managed by Spring Boot; SPIKE-003 gate) -->
        <!-- Flyway 10.x splits DB-specific support into separate modules; MySQL
             requires flyway-mysql in addition to flyway-core. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
