# AIProject SPIKE-002 local MySQL configuration.
# Copy this file to .env and fill in real local development values.
# Do NOT commit the real .env file.
# All password placeholders below are NON-functional markers only;
# real values must be set locally and must never be committed.

MYSQL_HOST_PORT=3306
MYSQL_DATABASE=aistudy_spike
MYSQL_USER=aistudy_spike
# Set to a local development password (not used in this file).
MYSQL_PASSWORD=CHANGE…ONLY
MYSQL_ROOT_PASSWORD=CHANGE…ONLY

# Used by Spring Boot integration test / packaged jar to reach this container from host.
DB_URL=jdbc:mysql://127.0.0.1:3306/aistudy_spike?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=aistudy_spike
DB_PASSWORD=CHANGE…ONLY
