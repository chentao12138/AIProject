# ============================================================
# AIStudy deployment secrets template
# Copy this file to .env and fill real values before deploy.
# ============================================================

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=aistudy
MYSQL_USER=aistudy
MYSQL_PASSWORD=

AUTH_JWT_SECRET=
AISTUDY_CORS_ALLOWED_ORIGINS=

AISTUDY_BOOTSTRAP_ADMIN_USERNAME=
AISTUDY_BOOTSTRAP_ADMIN_PASSWORD=

# Optional AI provider env defaults (AI-001). Leave disabled unless configured.
AISTUDY_AI_ENABLED=false
AISTUDY_AI_PROVIDER=openai-compatible
AISTUDY_AI_BASE_URL=
AISTUDY_AI_MODEL=
AISTUDY_AI_API_KEY=
# Base64 AES key (>=256-bit) required only for runtime BYOK secrets (AI-009).
AISTUDY_AI_SECRET_KEY=
